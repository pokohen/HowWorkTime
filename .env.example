# ── 공휴일 데이터 (scripts/fetchHolidays.js) ─────────────────────────────
# 공공데이터포털 (data.go.kr) 일반 인증키 (Decoded)
# 발급: https://www.data.go.kr/data/15012690/openapi.do (한국천문연구원 특일 정보)
# 주의: 이 키는 절대 공개 저장소에 커밋하지 않습니다. CI 에서는 GitHub Secrets 로 넣습니다.
DATA_GO_KR_KEY=

# ── 쉬는 날 플래너 (AI 대화) — 로컬 개발 전용 ─────────────────────────────
# 실제 사용은 앱 안의 ⚙ 설정에서 사용자가 직접 키를 넣는 방식입니다 (브라우저 localStorage 에만 저장).
# 아래 VITE_* 키는 `pnpm dev` 중에만 읽히고(import.meta.env.DEV), 빌드 결과에는 들어가지 않습니다.
# ⚠ GitHub Actions / Secrets 에 이 키들을 넣지 마세요. 정적 사이트 번들에 키가 박혀 누구나 꺼내 쓸 수 있습니다.
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
